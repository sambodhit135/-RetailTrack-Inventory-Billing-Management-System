# ================================================================
#  RetailTrack — Application Configuration
#  Copy this file to application.properties and fill in your values
# ================================================================

spring.application.name=retailtrack

# ----------------------------------------------------------------
#  DataSource — MySQL
#  Update the URL, username and password to match your local setup
# ----------------------------------------------------------------
spring.datasource.url=jdbc:mysql://localhost:3306/retailtrack_db?useSSL=false&serverTimezone=Asia/Kolkata&allowPublicKeyRetrieval=true
spring.datasource.username=root
spring.datasource.password=your_password_here
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# ----------------------------------------------------------------
#  HikariCP Connection Pool
# ----------------------------------------------------------------
spring.datasource.hikari.maximum-pool-size=10
spring.datasource.hikari.minimum-idle=2
spring.datasource.hikari.idle-timeout=30000
spring.datasource.hikari.connection-timeout=20000

# ----------------------------------------------------------------
#  JPA / Hibernate
# ----------------------------------------------------------------
# validate  → checks that schema matches entities (use in production)
# update    → auto-alters schema to match entities (safe for dev)
# create    → drops and recreates schema on startup (destructive!)
# none      → do nothing (use when running schema.sql manually)
# ----------------------------------------------------------------
spring.jpa.hibernate.ddl-auto=update

spring.jpa.properties.hibernate.format_sql=true
spring.jpa.show-sql=true
spring.jpa.open-in-view=false

# ----------------------------------------------------------------
#  Schema initialisation
#  Spring Boot will run src/main/resources/schema.sql on startup
#  when ddl-auto=validate/none and you want the DDL pre-applied.
#  Set to 'always' the FIRST time, then switch to 'never'.
# ----------------------------------------------------------------
spring.sql.init.mode=never

# ----------------------------------------------------------------
#  Jackson (JSON serialisation)
# ----------------------------------------------------------------
spring.jackson.serialization.write-dates-as-timestamps=false
spring.jackson.time-zone=Asia/Kolkata

# ----------------------------------------------------------------
#  Server
# ----------------------------------------------------------------
server.port=8080
server.error.include-message=always
server.error.include-binding-errors=always
